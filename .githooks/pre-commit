#!/bin/sh
# Refuse to commit a Stripe key (or a Supabase service key) pasted into source.
if git diff --cached -U0 | grep -E '^\+' | grep -Eq '(sk|rk)_(live|test)_[A-Za-z0-9]{8,}|eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{20,}'; then
  echo "pre-commit: that looks like a secret key. Keep keys in Netlify's environment, never in the repo." >&2
  exit 1
fi
