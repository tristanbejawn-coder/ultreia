# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for photos and posters; created by migration 001 (or in the dashboard)
SUPABASE_STORAGE_BUCKET=ultreia-media

# Satellite tiles. Default is Esri World Imagery (attribution required).
# For a paid product swap to a keyed provider, e.g. MapTiler:
#   https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=KEY
SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
SATELLITE_ATTRIBUTION=Imagery © Esri, Maxar, Earthstar Geographics

# Web push (npx web-push generate-vapid-keys). Optional — silently off without.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://ultreia.bejawn.studio

# Cloudflare Stream (phase "Voices"; optional in v1)
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=
